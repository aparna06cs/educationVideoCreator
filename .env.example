# Supabase (auth, database, small asset storage — free tier)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Groq (free tier) — powers lesson scripting. Get a key at https://console.groq.com
GROQ_API_KEY=

# Cloudflare R2 (free tier, 10GB + zero egress) — stores original source files and
# exported lesson videos. Create a bucket + API token at https://dash.cloudflare.com > R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Workers AI — powers illustration (flux-1-schnell) and narration (melotts).
# Replaces Pollinations.ai and StreamElements, which both became unusable:
# StreamElements now requires an API key, and Pollinations enforces a
# 1-request-per-IP queue that Cloudflare's shared egress IPs can't satisfy.
# CF_ACCOUNT_ID is optional if R2_ACCOUNT_ID is already set (same account).
# Create the token at dash.cloudflare.com > My Profile > API Tokens, using the
# "Workers AI" template (Account > Workers AI > Read).
CF_ACCOUNT_ID=
CF_AI_TOKEN=
